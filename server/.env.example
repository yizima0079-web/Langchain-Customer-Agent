# ===================== 应用基础配置 =====================
PROJECT_NAME=基于LangChain的带AI智能客服的微信小程序商城系统
DEBUG=true
# 后端对外 API 前缀
API_PREFIX=/api/v1

# ===================== 数据库配置（MySQL 8，端口 3306）=====================
# host 用 localhost：若服务器仅监听 IPv6(::1)，127.0.0.1(IPv4) 连不上
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=MySQL@123456
MYSQL_DB=shop_agent

# ===================== 认证配置 =====================
# JWT 签名密钥（生产环境务必更换为随机长字符串）
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
# Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===================== 文件上传配置 =====================
# 上传/静态资源根目录。默认 F:/uploads14（Windows 演示环境）；
# 其它系统请改为你本地路径。仓库内演示图素材见 server/assets/product/
UPLOAD_DIR=F:/uploads14

# ===================== LLM 大模型配置（OpenAI 兼容接口）=====================
# 阿里云百炼 DashScope 兼容模式接口地址
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 聊天模型（如实际模型名不同，请修改此处）
LLM_MODEL=qwen3.8-flash
# 嵌入模型
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 向量维度（该嵌入模型实测最大 1024）
EMBEDDING_DIM=1024
# 对话温度
LLM_TEMPERATURE=0.7
# ===== 大模型访问密钥（阿里云百炼 DashScope API-KEY）=====
# 填入形如 sk-xxxxxxxx 的密钥；留空则运行时读取系统环境变量 OPENAL_APLKEY
OPENAL_APLKEY=

# ===================== 向量数据库 Chroma 配置 =====================
# Chroma 持久化目录（请改为本地路径，勿用 F:/ 前缀的系统请改本机目录）
CHROMA_DIR=F:/uploads14/chroma

# ===================== 跨域配置 =====================
# 前端管理后台地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


