/**app.wxss 全局样式**/
page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
  padding-bottom: 128rpx;
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 通用按钮 */
.btn-primary {
  background: #409eff;
  color: #fff;
  border-radius: 8rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 价格 */
.price {
  color: #e4393c;
  font-weight: 600;
}
