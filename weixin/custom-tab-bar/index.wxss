.tabbar-shell {
  position: fixed;
  z-index: 9999;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 128rpx;
  padding: 15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(255, 255, 255, .8);
  background: rgba(255, 255, 255, .68);
  box-shadow: 0 -10rpx 30rpx rgba(38, 75, 120, .10);
  backdrop-filter: blur(24px) saturate(150%);
  -webkit-backdrop-filter: blur(24px) saturate(150%);
  overflow: hidden;
}
.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: rgba(72, 86, 105, .72);
  transition: color .2s ease;
}
.tab-icon {
  width: 58rpx;
  height: 48rpx;
  margin-bottom: 2rpx;
  border-radius: 20rpx;
  font-size: 38rpx;
  line-height: 48rpx;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(66, 126, 220, .12);
  transition: all .2s ease;
}
.tab-label {
  font-size: 21rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 5rpx rgba(255, 255, 255, .95);
}
.tab-item.active { color: #277be8; }
.tab-item.active .tab-icon {
  color: #2c85f5;
  background: rgba(74, 145, 255, .14);
  box-shadow: 0 0 18rpx rgba(58, 139, 255, .38), inset 0 1rpx 5rpx rgba(255, 255, 255, .8);
  text-shadow: 0 0 12rpx rgba(53, 143, 255, .82);
  transform: translateY(-3rpx);
}
.tab-item.active .tab-label {
  color: #176bd5;
  font-weight: 600;
  text-shadow: 0 0 8rpx rgba(75, 153, 255, .42);
}
