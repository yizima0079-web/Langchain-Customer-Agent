/**pages/mine/mine.wxss 个人中心样式**/
.container {
  padding: 20rpx;
}
.login-card {
  padding: 40rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
}
.input {
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}
.login-btn {
  background: #409eff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
}
.tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin-top: 20rpx;
}
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #409eff;
  color: #fff;
  text-align: center;
  line-height: 120rpx;
  font-size: 48rpx;
}
.nickname {
  font-size: 34rpx;
  font-weight: 600;
}
.username {
  color: #999;
  font-size: 26rpx;
  margin-top: 8rpx;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
}
.arrow {
  color: #ccc;
  font-size: 36rpx;
}
