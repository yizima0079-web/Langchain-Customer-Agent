.container { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f5f5f5; }
.card { margin-bottom: 24rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; }
.summary { text-align: center; }
.label { color: #666; font-size: 26rpx; }
.amount { margin: 12rpx 0; color: #e4393c; font-size: 52rpx; font-weight: 600; }
.order-no { color: #999; font-size: 23rpx; }
.card-title { margin-bottom: 20rpx; font-size: 30rpx; font-weight: 600; }
.method { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.method:last-child { border-bottom: 0; }
.method-icon { width: 64rpx; font-size: 38rpx; text-align: center; }
.method-info { flex: 1; margin-left: 18rpx; }
.method-name { font-size: 28rpx; }
.method-desc { margin-top: 8rpx; color: #999; font-size: 23rpx; }
.radio { width: 38rpx; height: 38rpx; border: 2rpx solid #ccc; border-radius: 50%; color: #fff; background: #fff; font-size: 28rpx; line-height: 38rpx; text-align: center; }
.selected .radio { border-color: #409eff; background: #409eff; }
.pay-button { margin-top: 40rpx; color: #fff; background: #e4393c; border-radius: 44rpx; }
