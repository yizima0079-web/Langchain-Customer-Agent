/**pages/product/product.wxss 商品详情样式**/
.page {
  padding-bottom: 120rpx;
}
.cover {
  width: 100%;
  height: 600rpx;
  background: #f0f0f0;
}
.info {
  margin: 20rpx;
}
.price-line {
  display: flex;
  align-items: baseline;
}
.price {
  color: #e4393c;
  font-size: 48rpx;
  font-weight: 600;
}
.original {
  color: #999;
  font-size: 26rpx;
  text-decoration: line-through;
  margin-left: 16rpx;
}
.name {
  font-size: 32rpx;
  margin-top: 12rpx;
  font-weight: 500;
}
.meta {
  color: #999;
  font-size: 24rpx;
  margin-top: 12rpx;
}
.desc {
  margin: 20rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1.6;
}
.desc-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}
.btn-cart,
.btn-buy {
  flex: 1;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.btn-cart {
  background: #ff9a2e;
  color: #fff;
}
.btn-buy {
  background: #e4393c;
  color: #fff;
}
